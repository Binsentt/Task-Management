PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/task-management
JWT_SECRET=replace-with-at-least-32-random-characters
# Set this to the frontend's exact public origin, including its port.
CLIENT_URL=http://localhost:5174
# Optional comma-separated additional frontend origins; never use a wildcard with credentials.
CORS_ORIGINS=
NODE_ENV=development
# Use "none" only when frontend and API are cross-site; production requires HTTPS.
COOKIE_SAMESITE=lax
# Required only for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURE=true
# TRUST_PROXY=1